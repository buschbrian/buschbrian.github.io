{
  "extends": [
    "html-validate:recommended",
    "html-validate:document"
  ],
  "rules": {
    "require-sri": "off",
    "aria-label-misuse": "off",
    "prefer-native-element": "off",
    "unique-landmark": "off",
    "attribute-misuse": "off",
    "heading-level": "off",
    "doctype-style": "off"
  }
}
